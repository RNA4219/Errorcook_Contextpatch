{
  "name": "contextpatch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ctxpatch": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts --help",
    "build": "tsup src/cli.ts --format esm,cjs --dts --out-dir dist",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^24.10.0",
    "eslint": "^9.13.0",
    "tsup": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
