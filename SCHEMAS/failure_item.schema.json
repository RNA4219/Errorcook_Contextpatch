{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "errorcook.failure_item",
  "type": "object",
  "required": [
    "tool",
    "message"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "meta": {
      "type": "object"
    }
  }
}