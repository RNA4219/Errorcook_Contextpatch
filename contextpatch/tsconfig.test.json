{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}