{
  "name": "errorcook",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "errorcook": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts --help",
    "build": "tsup src/cli.ts --format esm,cjs --dts --out-dir dist",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.13.0",
    "tsup": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^2.1.3"
  }
}
